{
  "uid": "kodama-logs",
  "title": "kodama — Logs",
  "tags": [
    "kodama",
    "logs",
    "loki"
  ],
  "timezone": "Europe/Dublin",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "🔥 Problems right now (last 1h, all services)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Error / warning count by service, last 1h",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (unit, container) (count_over_time({job=\"systemd-journal\", level=~\"err|crit|alert|emerg|warning\"} !~ \"session-[0-9]+\\\\.scope\" [1h]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": []
      },
      "options": {
        "sortBy": [{ "displayName": "Value", "desc": true }]
      }
    },

    { "id": 10, "type": "row", "title": "🎬 Jellyfin", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "panels": [] },
    {
      "id": 11, "type": "timeseries", "title": "Log volume",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 7, "x": 0, "y": 8 },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({job=\"systemd-journal\", container=\"jellyfin\"} |~ \"(?i)\\\\b(error|err|fatal|critical|panic)\\\\b\" [$__interval]))", "refId": "A", "legendFormat": "Error" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({job=\"systemd-journal\", container=\"jellyfin\"} |~ \"(?i)\\\\b(warn|warning)\\\\b\" [$__interval]))", "refId": "B", "legendFormat": "Warning" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({job=\"systemd-journal\", container=\"jellyfin\"} !~ \"(?i)\\\\b(error|err|fatal|critical|panic)\\\\b\" !~ \"(?i)\\\\b(warn|warning)\\\\b\" [$__interval]))", "refId": "C", "legendFormat": "Info" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "lineInterpolation": "linear", "barAlignment": 0, "barWidthFactor": 0.9, "lineWidth": 1, "fillOpacity": 100, "gradientMode": "none", "stacking": { "mode": "normal", "group": "A" }, "showPoints": "never" },
          "color": { "mode": "palette-classic" },
          "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Error" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Warning" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Info" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 12, "type": "logs", "title": "Logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 17, "x": 7, "y": 8 },
      "targets": [{ "datasource": { "type": "loki", "uid": "loki" }, "expr": "{job=\"systemd-journal\", container=\"jellyfin\"}", "refId": "A" }],
      "options": { "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" }
    },

